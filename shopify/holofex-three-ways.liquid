{% comment %}
  ============================================================
  HOLOFEX — "Three ways to create" section (Shopify)
  Black background · purple / blue / orange neon accents

  Install: Online Store → Themes → Edit code → sections/
           → Add a new section → "holofex-three-ways"
           → paste this whole file, save, then add the section
           in the theme customizer.

  Each card is a block with:
    · Badge + small kicker label
    · Square image slot (PNG picker) — falls back to a built-in
      neon holo-pedestal (with your text, or a phoenix drawing)
    · Optional AI "prompt" overlay box on the image
    · Body copy, "Perfect for:" line, outlined CTA button
    · Accent colour (cyan / blue / purple / magenta / orange)
  ============================================================
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Exo+2:wght@400;600;700;800&display=swap" rel="stylesheet">

{%- liquid
  assign uid = section.id
  assign phx_grad = 'twphx-g-' | append: uid
  assign phx_art = 'twphx-art-' | append: uid
-%}

<style>
/* ==========================================================
   HOLOFEX THREE WAYS — all rules scoped under .hfx-tw
   ========================================================== */
.hfx-tw, .hfx-tw * { margin: 0; padding: 0; box-sizing: border-box; }

.hfx-tw a { color: inherit; text-decoration: none; }

.hfx-tw {
  --cyan: #00e0ff;
  --blue: #2e7cff;
  --purple: #7f5bff;
  --magenta: #ff2dff;
  --orange: #ff8a00;
  --text: #f4f4fa;
  --text-dim: #9a9ab4;

  position: relative;
  background: var(--hfx-tw-bgc, #f5f5f5);
  color: var(--text);
  font-family: "Exo 2", system-ui, sans-serif;
  -webkit-font-smoothing: antialiased;
  padding: clamp(56px, 8vh, 100px) clamp(20px, 4vw, 48px);
  overflow: hidden;
  isolation: isolate;
}

.hfx-tw-bg {
  position: absolute;
  inset: 0;
  z-index: -1;
  background:
    radial-gradient(42% 50% at 10% 0%,   rgba(127, 91, 255, 0.12), transparent 65%),
    radial-gradient(40% 46% at 90% 100%, rgba(255, 138, 0, 0.08),  transparent 65%),
    radial-gradient(36% 42% at 85% 0%,   rgba(46, 124, 255, 0.09), transparent 65%);
}

/* ---------- light-background mode (auto when the picked colour is light) ---------- */
.hfx-tw-light .hfx-tw-bg { opacity: 0.45; }
.hfx-tw-light .hfx-tw-title { color: #0d0d16; }
.hfx-tw-light .hfx-tw-sub { color: #5c5c72; }
.hfx-tw-light .hfx-tw-card {
  border-color: color-mix(in srgb, var(--acc) 38%, transparent);
  box-shadow: 0 14px 44px rgba(12, 12, 26, 0.16);
}
.hfx-tw-light .hfx-tw-card:hover {
  border-color: color-mix(in srgb, var(--acc) 62%, transparent);
  box-shadow: 0 22px 60px rgba(12, 12, 26, 0.22), 0 0 44px color-mix(in srgb, var(--acc) 26%, transparent);
}

.hfx-tw-inner { max-width: var(--hfx-tw-max-w, 1280px); margin: 0 auto; }

/* ---------- header ---------- */
.hfx-tw-head { text-align: center; max-width: 720px; margin: 0 auto clamp(36px, 5vh, 56px); }

.hfx-tw-title {
  font-size: clamp(26px, 3.2vw, 42px);
  font-weight: 800;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  margin-bottom: 12px;
}
.hfx-tw-sub { font-size: clamp(14px, 1.1vw, 16px); color: var(--text-dim); line-height: 1.6; }

/* ---------- card grid ---------- */
.hfx-tw-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: clamp(18px, 2vw, 28px);
  align-items: stretch;
}

/* accent palettes (set per card) */
.hfx-tw-a-cyan    { --acc: #00e0ff; --acc2: #2e7cff; --acc-ink: #baf3ff; }
.hfx-tw-a-blue    { --acc: #2e7cff; --acc2: #00e0ff; --acc-ink: #b9d4ff; }
.hfx-tw-a-purple  { --acc: #7f5bff; --acc2: #ff2dff; --acc-ink: #d3c5ff; }
.hfx-tw-a-magenta { --acc: #ff2dff; --acc2: #7f5bff; --acc-ink: #ffc4ff; }
.hfx-tw-a-orange  { --acc: #ff8a00; --acc2: #ff2dff; --acc-ink: #ffd9ae; }

.hfx-tw-card {
  display: flex;
  flex-direction: column;
  border-radius: 18px;
  border: 1px solid color-mix(in srgb, var(--acc) 26%, transparent);
  background: linear-gradient(180deg, #0c0c16, #07070e);
  padding: 18px 18px 22px;
  transition: transform 0.28s ease, box-shadow 0.28s ease, border-color 0.28s ease;
}
.hfx-tw-card:hover {
  transform: translateY(-5px);
  border-color: color-mix(in srgb, var(--acc) 55%, transparent);
  box-shadow: 0 18px 50px rgba(0, 0, 0, 0.6), 0 0 44px color-mix(in srgb, var(--acc) 22%, transparent);
}

/* ---------- badge row ---------- */
.hfx-tw-badges { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; flex-wrap: wrap; }

.hfx-tw-badge {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #fff;
  padding: 5px 11px;
  border-radius: 7px;
  background: linear-gradient(95deg, var(--acc), var(--acc2));
  box-shadow: 0 0 16px color-mix(in srgb, var(--acc) 40%, transparent);
  white-space: nowrap;
}
.hfx-tw-kicker {
  font-size: 9.5px;
  font-weight: 600;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--text-dim);
  white-space: nowrap;
}

/* ---------- media ---------- */
.hfx-tw-media {
  position: relative;
  aspect-ratio: 1;
  border-radius: 13px;
  overflow: hidden;
  margin-bottom: 18px;
  border: 1px solid rgba(255, 255, 255, 0.06);
  background:
    radial-gradient(75% 70% at 50% 38%, color-mix(in srgb, var(--acc) 13%, transparent), transparent 72%),
    radial-gradient(60% 50% at 50% 100%, color-mix(in srgb, var(--acc2) 9%, transparent), transparent 70%),
    #05050c;
}

.hfx-tw-media .hfx-tw-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* subtle holographic scanlines over the media */
.hfx-tw-scan {
  position: absolute;
  inset: 0;
  background: repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.028) 0 1px, transparent 1px 4px);
  mix-blend-mode: screen;
  pointer-events: none;
}

/* ---------- built-in pedestal fallback ---------- */
.hfx-tw-holo { position: absolute; inset: 0; }

.hfx-tw-pad {
  position: absolute;
  bottom: 8%;
  left: 50%;
  transform: translateX(-50%);
  width: 64%;
  height: 12%;
  border-radius: 50%;
  border: 2px solid color-mix(in srgb, var(--acc) 55%, transparent);
  background: radial-gradient(50% 50% at 50% 50%, color-mix(in srgb, var(--acc) 24%, transparent), transparent 72%);
  box-shadow:
    0 0 26px color-mix(in srgb, var(--acc) 45%, transparent),
    inset 0 0 18px color-mix(in srgb, var(--acc) 30%, transparent);
}
.hfx-tw-pad::after {
  content: "";
  position: absolute;
  inset: 22% 16%;
  border-radius: 50%;
  border: 1px solid color-mix(in srgb, var(--acc2) 45%, transparent);
}

.hfx-tw-beam {
  position: absolute;
  bottom: 13%;
  left: 50%;
  transform: translateX(-50%);
  width: 52%;
  height: 60%;
  background: linear-gradient(180deg, transparent 4%, color-mix(in srgb, var(--acc) 15%, transparent));
  clip-path: polygon(36% 0, 64% 0, 100% 100%, 0 100%);
  filter: blur(2px);
  pointer-events: none;
}

.hfx-tw-holo-art {
  position: absolute;
  left: 50%;
  bottom: 26%;
  transform: translateX(-50%);
  width: 74%;
  display: grid;
  place-items: center;
  animation: hfx-tw-float 5.5s ease-in-out infinite;
  filter:
    drop-shadow(0 0 20px color-mix(in srgb, var(--acc) 45%, transparent))
    drop-shadow(0 0 46px color-mix(in srgb, var(--acc2) 30%, transparent));
}
@keyframes hfx-tw-float {
  0%, 100% { transform: translateX(-50%) translateY(0); }
  50%      { transform: translateX(-50%) translateY(-9px); }
}

.hfx-tw-holo-text {
  font-weight: 800;
  font-size: clamp(26px, 2.4vw, 38px);
  line-height: 1.05;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  text-align: center;
  background: linear-gradient(180deg, var(--acc-ink), var(--acc) 55%, var(--acc2));
  -webkit-background-clip: text; background-clip: text;
  -webkit-text-fill-color: transparent; color: transparent;
}

.hfx-tw-holo-art svg { width: 82%; height: auto; }

/* floating deco sparks in the fallback */
.hfx-tw-spark {
  position: absolute;
  width: 7px; height: 7px;
  border: 1px solid color-mix(in srgb, var(--acc) 70%, transparent);
  border-radius: 2px;
  transform: rotate(18deg);
  animation: hfx-tw-float 6.5s ease-in-out infinite;
}
.hfx-tw-spark.hfx-tw-s1 { top: 16%; left: 16%; }
.hfx-tw-spark.hfx-tw-s2 { top: 26%; right: 14%; width: 10px; height: 10px; animation-delay: 1.1s; border-color: color-mix(in srgb, var(--acc2) 70%, transparent); }
.hfx-tw-spark.hfx-tw-s3 { top: 55%; left: 10%; width: 5px; height: 5px; animation-delay: 2s; }

/* ---------- prompt overlay ---------- */
.hfx-tw-prompt {
  position: absolute;
  left: 10px; right: 10px; bottom: 10px;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 9px 11px;
  border-radius: 11px;
  border: 1px solid color-mix(in srgb, var(--acc) 35%, transparent);
  background: rgba(8, 8, 16, 0.74);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}
.hfx-tw-prompt-copy { flex: 1; min-width: 0; }
.hfx-tw-prompt-copy small {
  display: block;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 0.26em;
  text-transform: uppercase;
  color: var(--text-dim);
  margin-bottom: 3px;
}
.hfx-tw-prompt-copy p { font-size: 11px; line-height: 1.45; color: #d9d9ea; }

.hfx-tw-dl {
  flex: none;
  width: 34px; height: 34px;
  border-radius: 9px;
  display: grid;
  place-items: center;
  color: var(--acc-ink);
  border: 1px solid color-mix(in srgb, var(--acc) 45%, transparent);
  background: color-mix(in srgb, var(--acc) 12%, transparent);
}
.hfx-tw-dl svg { width: 15px; height: 15px; }

/* ---------- copy ---------- */
.hfx-tw-body { font-size: 14.5px; line-height: 1.65; color: #cfcfe2; margin-bottom: 14px; }

.hfx-tw-perfect { font-size: 12.5px; line-height: 1.6; letter-spacing: 0.02em; color: var(--text-dim); margin-bottom: 22px; }

/* ---------- CTA ---------- */
.hfx-tw-btn {
  position: relative;
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  padding: 13px 40px;
  border-radius: 11px;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--acc-ink);
  border: 1px solid color-mix(in srgb, var(--acc) 45%, transparent);
  background: color-mix(in srgb, var(--acc) 6%, transparent);
  transition: transform 0.22s ease, box-shadow 0.22s ease, background 0.22s ease, border-color 0.22s ease;
}
.hfx-tw-btn svg {
  position: absolute;
  right: 15px;
  top: 50%;
  transform: translateY(-50%);
  width: 16px; height: 16px;
  transition: transform 0.22s ease;
}
.hfx-tw-btn:hover {
  transform: translateY(-2px);
  border-color: color-mix(in srgb, var(--acc) 75%, transparent);
  background: color-mix(in srgb, var(--acc) 13%, transparent);
  box-shadow: 0 0 26px color-mix(in srgb, var(--acc) 30%, transparent);
}
.hfx-tw-btn:hover svg { transform: translateY(-50%) translateX(3px); }

/* ---------- swipe indicator (mobile only) ---------- */
.hfx-tw-swipe { display: none; }

/* ---------- responsive ---------- */
@media (max-width: 1080px) {
  .hfx-tw-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (max-width: 720px) {
  /* cards become a swipeable sliding bar with the next card peeking in */
  .hfx-tw-grid {
    display: flex;
    gap: 14px;
    overflow-x: auto;
    margin: 0 -20px;
    padding: 4px 20px 8px;
    scroll-snap-type: x mandatory;
    scroll-padding-left: 20px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 16px, #000 calc(100% - 34px), transparent);
            mask-image: linear-gradient(90deg, transparent, #000 16px, #000 calc(100% - 34px), transparent);
  }
  .hfx-tw-grid::-webkit-scrollbar { display: none; }
  .hfx-tw-card { flex: 0 0 85%; scroll-snap-align: start; }

  .hfx-tw-swipe {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 11px;
    margin-top: 18px;
  }
  .hfx-tw-dots { display: flex; gap: 8px; }
  .hfx-tw-dot {
    width: 8px; height: 8px;
    border-radius: 999px;
    border: 0; padding: 0;
    background: rgba(255, 255, 255, 0.22);
    cursor: pointer;
    transition: width 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  .hfx-tw-dot.hfx-on {
    width: 22px;
    background: linear-gradient(90deg, var(--purple), var(--magenta));
    box-shadow: 0 0 10px rgba(255, 45, 255, 0.5);
  }
  .hfx-tw-hint {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--text-dim);
    transition: opacity 0.4s ease;
  }
  .hfx-tw-hint svg { width: 14px; height: 14px; animation: hfx-tw-nudge 1.4s ease-in-out infinite; }
  .hfx-tw-hint.hfx-hide { opacity: 0; }
  @keyframes hfx-tw-nudge {
    0%, 100% { transform: translateX(0); }
    50%      { transform: translateX(5px); }
  }
  .hfx-tw-light .hfx-tw-dot { background: rgba(12, 12, 26, 0.18); }
  .hfx-tw-light .hfx-tw-hint { color: #6a6a82; }
}

@media (prefers-reduced-motion: reduce) {
  .hfx-tw *, .hfx-tw *::before, .hfx-tw *::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; }
}
</style>


{%- liquid
  assign tw_bgc = section.settings.background_color | default: '#F5F5F5'
  assign tw_bgc_str = tw_bgc | append: ''
  if tw_bgc_str == blank or tw_bgc_str == 'rgba(0,0,0,0)'
    assign tw_bgc = '#F5F5F5'
  endif
  assign tw_bright = tw_bgc | color_brightness | default: 245
  if tw_bright > 140
    assign tw_mode = 'hfx-tw-light'
  else
    assign tw_mode = ''
  endif
-%}
<section class="hfx-tw {{ tw_mode }}" style="--hfx-tw-max-w: {{ section.settings.max_width | default: 1280 }}px; --hfx-tw-bgc: {{ tw_bgc }};">
  <div class="hfx-tw-bg" aria-hidden="true"></div>

  <div class="hfx-tw-inner">

    <div class="hfx-tw-head">
      {%- if section.settings.heading != blank -%}
        <h2 class="hfx-tw-title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="hfx-tw-sub">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="hfx-tw-grid" id="hfx-tw-track-{{ uid }}">
      {%- for block in section.blocks -%}
        <article class="hfx-tw-card hfx-tw-a-{{ block.settings.accent }}" {{ block.shopify_attributes }}>

          <div class="hfx-tw-badges">
            {%- if block.settings.badge != blank -%}
              <span class="hfx-tw-badge">{{ block.settings.badge }}</span>
            {%- endif -%}
            {%- if block.settings.kicker != blank -%}
              <span class="hfx-tw-kicker">{{ block.settings.kicker }}</span>
            {%- endif -%}
          </div>

          <div class="hfx-tw-media">
            {%- if block.settings.card_image -%}
              {{ block.settings.card_image | image_url: width: 900 | image_tag: class: 'hfx-tw-img', loading: 'lazy', widths: '450, 900' }}
            {%- else -%}
              <div class="hfx-tw-holo" aria-hidden="true">
                <span class="hfx-tw-spark hfx-tw-s1"></span>
                <span class="hfx-tw-spark hfx-tw-s2"></span>
                <span class="hfx-tw-spark hfx-tw-s3"></span>
                <span class="hfx-tw-beam"></span>
                <span class="hfx-tw-pad"></span>
                <div class="hfx-tw-holo-art">
                  {%- if block.settings.fallback_text != blank -%}
                    <span class="hfx-tw-holo-text">{{ block.settings.fallback_text }}</span>
                  {%- else -%}
                    <svg viewBox="0 0 440 420"><use href="#{{ phx_art }}"/></svg>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
            <span class="hfx-tw-scan" aria-hidden="true"></span>

            {%- if block.settings.prompt_text != blank -%}
              <div class="hfx-tw-prompt">
                <div class="hfx-tw-prompt-copy">
                  <small>{{ block.settings.prompt_label | default: 'Prompt' }}</small>
                  <p>{{ block.settings.prompt_text }}</p>
                </div>
                <span class="hfx-tw-dl" aria-hidden="true">
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v8m0 0L5 7m3 3l3-3"/><path d="M3 13h10"/></svg>
                </span>
              </div>
            {%- endif -%}
          </div>

          {%- if block.settings.body_text != blank -%}
            <p class="hfx-tw-body">{{ block.settings.body_text }}</p>
          {%- endif -%}

          {%- if block.settings.perfect_for != blank -%}
            <p class="hfx-tw-perfect">{{ block.settings.perfect_for }}</p>
          {%- endif -%}

          {%- if block.settings.button_label != blank -%}
            <a class="hfx-tw-btn" href="{{ block.settings.button_link | default: '#' }}">
              {{ block.settings.button_label }}
              <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          {%- endif -%}

        </article>
      {%- endfor -%}
    </div>

    {%- if section.blocks.size > 1 -%}
      <div class="hfx-tw-swipe" id="hfx-tw-swipe-{{ uid }}" aria-hidden="true">
        <div class="hfx-tw-dots">
          {%- for block in section.blocks -%}
            <button type="button" class="hfx-tw-dot{% if forloop.first %} hfx-on{% endif %}" data-i="{{ forloop.index0 }}" aria-label="Go to card {{ forloop.index }}" tabindex="-1"></button>
          {%- endfor -%}
        </div>
        <span class="hfx-tw-hint">
          {{ section.settings.swipe_hint | default: 'Swipe to explore' }}
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 8h11M9.5 4.5 13 8l-3.5 3.5"/></svg>
        </span>
      </div>
    {%- endif -%}
  </div>
</section>

{%- if section.blocks.size > 1 -%}
<script>
(function () {
  var track = document.getElementById('hfx-tw-track-{{ uid }}');
  var wrap = document.getElementById('hfx-tw-swipe-{{ uid }}');
  if (!track || !wrap) return;
  var dots = wrap.querySelectorAll('.hfx-tw-dot');
  var hint = wrap.querySelector('.hfx-tw-hint');
  var scrolled = false;

  function step() {
    var card = track.children[0];
    return card ? card.offsetWidth + 14 : 1;
  }
  function update() {
    var i = Math.round(track.scrollLeft / step());
    i = Math.max(0, Math.min(dots.length - 1, i));
    for (var d = 0; d < dots.length; d++) dots[d].classList.toggle('hfx-on', d === i);
  }

  track.addEventListener('scroll', function () {
    if (!scrolled) { scrolled = true; if (hint) hint.classList.add('hfx-hide'); }
    update();
  }, { passive: true });

  for (var d = 0; d < dots.length; d++) (function (i) {
    dots[i].addEventListener('click', function () {
      track.scrollTo({ left: i * step(), behavior: 'smooth' });
    });
  })(d);
})();
</script>
{%- endif -%}


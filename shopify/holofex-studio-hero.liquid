            { "value": "pen", "label": "Design pen" },
            { "value": "cast", "label": "Download & cast" }
          ],
          "default": "sparkle"
        },
        {
          "type": "select",
          "id": "accent",
          "label": "Accent colour",
          "options": [
            { "value": "cyan", "label": "Cyan" },

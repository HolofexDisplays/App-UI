<section
  class="hfx-hero"
  style="--hfx-max-w: {{ section.settings.max_width | default: 2600 }}px; --hfx-min-h: {{ section.settings.min_height | default: 1100 }}px;"
>
  <div class="hfx-hero-bg" aria-hidden="true"></div>
  <div class="hfx-hero-grid" aria-hidden="true"></div>

  <div class="hfx-hero-inner">

    {%- comment -%} ---------- LEFT : copy ---------- {%- endcomment -%}
    <div class="hfx-copy">

      {%- if section.settings.logo_image -%}
        {{ section.settings.logo_image | image_url: width: 640 | image_tag: class: 'hfx-logo', loading: 'eager', widths: '320, 640' }}
      {%- endif -%}

      {%- if section.settings.tagline != blank -%}
        <p class="hfx-tagline"><i></i>{{ section.settings.tagline }}</p>
      {%- endif -%}

      <h1 class="hfx-heading">
        {%- if section.settings.heading_line_1 != blank -%}
          <span class="hfx-w-create">{{ section.settings.heading_line_1 }}</span>
        {%- endif -%}
        {%- if section.settings.heading_line_2 != blank -%}
          <span class="hfx-w-download">{{ section.settings.heading_line_2 }}</span>
        {%- endif -%}
        {%- if section.settings.heading_line_3 != blank -%}
          <span class="hfx-w-display">{{ section.settings.heading_line_3 }}</span>
        {%- endif -%}
      </h1>

      {%- if section.settings.body_text != blank -%}
        <p class="hfx-lede">{{ section.settings.body_text }}</p>
      {%- endif -%}

      <div class="hfx-cta-row">
        {%- if section.settings.button_1_label != blank -%}
          <a class="hfx-btn hfx-btn-primary" href="{{ section.settings.button_1_link | default: '#' }}">
            {{ section.settings.button_1_label }}
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.button_2_label != blank -%}
          <a class="hfx-btn hfx-btn-ghost" href="{{ section.settings.button_2_link | default: '#' }}">
            <span class="hfx-spark">✦</span>
            {{ section.settings.button_2_label }}
          </a>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="hfx-features">
          {%- for block in section.blocks -%}
            <div class="hfx-feature hfx-h-{{ block.settings.accent }}" {{ block.shopify_attributes }}>
              <span class="hfx-f-ico hfx-f-{{ block.settings.accent }}">
                {%- if block.settings.icon_image -%}
                  {{ block.settings.icon_image | image_url: width: 44 | image_tag: loading: 'lazy' }}
                {%- else -%}
                  {%- case block.settings.icon -%}
                    {%- when 'cube' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7.5 4.3v8.6L12 20.2l-7.5-4.3V7.3L12 3z"/><path d="M12 3v8.6m0 0l7.5 4.3M12 11.6l-7.5 4.3"/></svg>
                    {%- when 'pen' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 14.5l6.5-6.4a2.2 2.2 0 0 0 0-3.1 2.2 2.2 0 0 0-3.1 0L9 11.4 7.6 16.4l5-1.4z"/><path d="M4 20h16"/></svg>
                    {%- when 'cast' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v9m0 0l-3.4-3.4M12 12l3.4-3.4"/><path d="M5.5 17.5a9 9 0 0 0 13 0M8 20.2a5.6 5.6 0 0 0 8 0"/></svg>
                    {%- else -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l1.9 4.6L18.5 9.5l-4.6 1.9L12 16l-1.9-4.6L5.5 9.5l4.6-1.9L12 3z"/><path d="M18.5 15.5l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8.8-2z"/></svg>
                  {%- endcase -%}
                {%- endif -%}
              </span>
              <strong>{{ block.settings.label }}</strong>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.footnote != blank -%}
        <p class="hfx-footnote">{{ section.settings.footnote }}</p>
      {%- endif -%}
    </div>

    {%- comment -%} ---------- RIGHT : pipeline scene ---------- {%- endcomment -%}
    <div class="hfx-scene-wrap" role="img" aria-label="From HoloStudio on laptop, download to phone, then cast to a Holofex display">
      <div class="hfx-scene">

        <svg class="hfx-sc-arrows" viewBox="0 0 640 700" aria-hidden="true">
          <defs>
            <marker id="{{ arrow_a }}" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
              <path d="M0 0L10 5L0 10z" fill="#9a7dff"/>
            </marker>
            <marker id="{{ arrow_b }}" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
              <path d="M0 0L10 5L0 10z" fill="#ff8a00"/>
            </marker>
          </defs>
          <path class="hfx-flow hfx-flow-a" d="M225 240 C 250 280, 235 292, 210 312" marker-end="url(#{{ arrow_a }})"/>
          <path class="hfx-flow hfx-flow-b" d="M262 520 C 350 566, 440 540, 476 452" marker-end="url(#{{ arrow_b }})"/>
        </svg>
        <span class="hfx-flow-label hfx-fl-a">{{ section.settings.arrow_label_1 | default: 'Download' }}</span>
        <span class="hfx-flow-label hfx-fl-b">{{ section.settings.arrow_label_2 | default: 'Cast' }}</span>

        {%- comment -%} laptop : HoloStudio — image slot: laptop_image {%- endcomment -%}
        <div class="hfx-sc-laptop">
          <div class="hfx-laptop-screen">
            <div class="hfx-ui">
              <div class="hfx-ui-top">
                <span class="hfx-ui-dot" style="background:#ff5f57"></span>
                <span class="hfx-ui-dot" style="background:#febc2e"></span>
                <span class="hfx-ui-dot" style="background:#28c840"></span>
                <span class="hfx-t">{{ section.settings.laptop_app_name | default: 'HOLOSTUDIO' }}</span>
                <span class="hfx-chip">EXPORT</span>
              </div>
              <div class="hfx-ui-body">
                <div class="hfx-ui-tools">
                  <span class="hfx-ui-tool hfx-on"></span>
                  <span class="hfx-ui-tool"></span>
                  <span class="hfx-ui-tool"></span>
                  <span class="hfx-ui-tool"></span>
                </div>
                <div class="hfx-ui-canvas">
                  <div class="hfx-sel"><i></i><i></i><i></i><i></i></div>
                  {%- if section.settings.laptop_image -%}
                    {{ section.settings.laptop_image | image_url: width: 600 | image_tag: class: 'hfx-canvas-img', loading: 'lazy', widths: '300, 600' }}
                  {%- else -%}
                    <svg viewBox="0 0 440 420"><use href="#{{ phx_art }}" stroke-width="4"/></svg>
                  {%- endif -%}
                </div>
                <div class="hfx-ui-panel">
                  <span class="hfx-ui-line"></span>
                  <span class="hfx-ui-slider hfx-s1"><span></span></span>
                  <span class="hfx-ui-line hfx-short"></span>
                  <span class="hfx-ui-slider hfx-s2"><span></span></span>
                  <span class="hfx-ui-line hfx-short"></span>
                  <span class="hfx-ui-slider hfx-s3"><span></span></span>
                  <span class="hfx-ui-swatches">
                    <i style="background:#00e0ff"></i>
                    <i style="background:#7f5bff"></i>
                    <i style="background:#ff2dff"></i>
                    <i style="background:#ff8a00"></i>
                  </span>
                </div>
              </div>
              <div class="hfx-ui-timeline">
                <span class="hfx-ui-play">▶</span>
                <span class="hfx-ui-track"><span></span></span>
                <span class="hfx-ui-time">0:04 / 0:06</span>
              </div>
            </div>
          </div>
          <div class="hfx-laptop-base"></div>
          <p class="hfx-sc-caption">{{ section.settings.caption_1 | default: '1 · Create in HoloStudio' }}</p>
        </div>

        {%- comment -%} phone : downloaded hologram — image slot: phone_image {%- endcomment -%}
        <div class="hfx-sc-phone">
          <div class="hfx-phone-frame">
            <div class="hfx-phone-screen">
              <span class="hfx-phone-notch"></span>
              <p class="hfx-phone-head">{{ section.settings.phone_app_name | default: 'HOLOFEX' }}</p>
              <div class="hfx-phone-thumb">
                {%- if section.settings.phone_image -%}
                  {{ section.settings.phone_image | image_url: width: 400 | image_tag: class: 'hfx-thumb-img', loading: 'lazy', widths: '200, 400' }}
                {%- else -%}
                  <svg viewBox="0 0 440 420"><use href="#{{ phx_art }}" stroke-width="5"/></svg>
                {%- endif -%}
              </div>
              <div class="hfx-phone-file">
                <b>{{ section.settings.phone_file_name | default: 'phoenix_loop.holo' }}</b>
                <span>{{ section.settings.phone_file_size | default: '24 MB' }}</span>
              </div>
              <p class="hfx-phone-pill">✓&nbsp; DOWNLOADED</p>
              <span class="hfx-phone-cast">▶&nbsp; CAST TO DISPLAY</span>
            </div>
          </div>
          <p class="hfx-sc-caption">{{ section.settings.caption_2 | default: '2 · On your phone' }}</p>
        </div>

        {%- comment -%} Holofex display — image slot: hologram_image (the circle) {%- endcomment -%}
        <div class="hfx-sc-display">
          <div class="hfx-fan-zone">
            <div class="hfx-fan-ring">
              <span class="hfx-fan-blade"></span>
              <span class="hfx-fan-scan"></span>
              <span class="hfx-fan-hub"></span>
            </div>
            <div class="hfx-holo-art">
              {%- if section.settings.hologram_image -%}
                {{ section.settings.hologram_image | image_url: width: 1200 | image_tag: class: 'hfx-holo-img', loading: 'lazy', widths: '400, 800, 1200' }}
              {%- else -%}
                <svg viewBox="0 0 440 420">
                  <use href="#{{ phx_art }}" stroke-width="7" filter="url(#{{ phx_blur }})" opacity="0.85"/>
                  <use href="#{{ phx_art }}" stroke-width="2.4"/>
                </svg>
              {%- endif -%}
            </div>
          </div>
          <div class="hfx-display-stand"></div>
          <div class="hfx-display-base"></div>
          <div class="hfx-display-shadow" aria-hidden="true"></div>
          <p class="hfx-display-caption">
            {{ section.settings.caption_3 | default: '3 · Holofex X1' }}
            {%- if section.settings.show_live_badge %} <span class="hfx-live">LIVE</span>{% endif -%}
          </p>
        </div>

      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Holofex Studio Hero",
  "tag": "section",
  "class": "hfx-hero-section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width (px)",
      "min": 1200,
      "max": 2600,
      "step": 50,
      "default": 2600
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height (px)",
      "min": 600,
      "max": 1400,
      "step": 50,
      "default": 1100
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo (PNG, optional)",
      "info": "Shown above the tagline. Leave empty to hide."
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "The holographic content suite"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading line 1",
      "default": "Create."
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading line 2",
      "default": "Download."
    },
    {
      "type": "text",
      "id": "heading_line_3",
      "label": "Heading line 3",
      "default": "Display."
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Supporting copy",
      "default": "Everything you need to create holographic content. Generate AI hologram animations, transform existing artwork into 3D holograms, or work with our professional design team."
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Footnote",

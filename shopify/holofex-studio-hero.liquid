{% comment %}
  ============================================================
  HOLOFEX STUDIO — premium hero section (Shopify)
  Black background · purple / blue / orange neon gradients
  Container: max 2600px wide × 1100px tall (adjustable below)

  Install: Online Store → Themes → Edit code → sections/
           → Add a new section → "holofex-studio-hero"
           → paste this whole file, save, then add the section
           in the theme customizer and upload your PNGs.

  Image slots (all accept transparent PNGs):
    · Hologram image   → inside the circular Holofex display
    · Laptop screen    → canvas of the HoloStudio mock UI
    · Phone screen     → thumbnail on the phone
    · Logo (optional)  → above the tagline on the left
  Each slot falls back to a built-in neon phoenix drawing
  until an image is uploaded.
  ============================================================
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Exo+2:wght@400;600;700;800&display=swap" rel="stylesheet">

{%- liquid
  assign uid = section.id
  assign phx_grad = 'phx-g-' | append: uid
  assign phx_blur = 'phx-blur-' | append: uid
  assign phx_art = 'phx-art-' | append: uid
  assign arrow_a = 'ah-a-' | append: uid
  assign arrow_b = 'ah-b-' | append: uid
-%}

<style>
/* ==========================================================
   HOLOFEX STUDIO HERO — all rules scoped under .hfx-hero
   ========================================================== */
.hfx-hero, .hfx-hero * { margin: 0; padding: 0; box-sizing: border-box; }

.hfx-hero a { color: inherit; text-decoration: none; }

/* ---------- section container ---------- */
.hfx-hero {
  --cyan: #00e0ff;
  --blue: #2e7cff;
  --purple: #7f5bff;
  --magenta: #ff2dff;
  --orange: #ff8a00;
  --teal: #00ffd1;
  --bg: #000000;
  --card: rgba(18, 18, 29, 0.72);
  --line: rgba(127, 91, 255, 0.22);
  --text: #f4f4fa;
  --text-dim: #9a9ab4;
  --grad-hot: linear-gradient(90deg, var(--cyan), var(--purple) 40%, var(--magenta) 70%, var(--orange));

  position: relative;
  width: 100%;
  max-width: var(--hfx-max-w, 2600px);
  min-height: var(--hfx-min-h, 1100px);
  margin: 0 auto;
  overflow: hidden;
  isolation: isolate;
  display: flex;
  align-items: center;
  background: var(--bg);
  color: var(--text);
  font-family: "Exo 2", system-ui, sans-serif;
  -webkit-font-smoothing: antialiased;
}

.hfx-hero-bg {
  position: absolute;
  inset: 0;
  z-index: -2;
  background:
    radial-gradient(52% 44% at 12% 8%,  rgba(127, 91, 255, 0.20), transparent 65%),
    radial-gradient(44% 40% at 88% 16%, rgba(46, 124, 255, 0.14), transparent 65%),
    radial-gradient(50% 46% at 82% 88%, rgba(255, 138, 0, 0.12),  transparent 65%),
    radial-gradient(36% 34% at 30% 92%, rgba(255, 45, 255, 0.08), transparent 65%),
    #000;
}

.hfx-hero-grid {
  position: absolute;
  inset: 0;
  z-index: -1;
  background-image:
    linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
  background-size: 72px 72px;
  -webkit-mask-image: radial-gradient(70% 62% at 50% 42%, #000 0%, transparent 100%);
          mask-image: radial-gradient(70% 62% at 50% 42%, #000 0%, transparent 100%);
}

/* ---------- layout ---------- */
.hfx-hero-inner {
  width: 100%;
  max-width: 1920px;
  margin: 0 auto;
  padding: clamp(48px, 6vh, 88px) clamp(24px, 4vw, 80px);
  display: grid;
  grid-template-columns: minmax(0, 1.02fr) minmax(0, 1fr);
  align-items: center;
  gap: clamp(32px, 4vw, 90px);
}

/* ---------- left column ---------- */
.hfx-copy { max-width: 620px; }

.hfx-copy > * { opacity: 0; animation: hfx-rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) forwards; }
.hfx-copy > *:nth-child(1) { animation-delay: 0.05s; }
.hfx-copy > *:nth-child(2) { animation-delay: 0.15s; }
.hfx-copy > *:nth-child(3) { animation-delay: 0.25s; }
.hfx-copy > *:nth-child(4) { animation-delay: 0.38s; }
.hfx-copy > *:nth-child(5) { animation-delay: 0.5s; }
.hfx-copy > *:nth-child(6) { animation-delay: 0.62s; }
.hfx-copy > *:nth-child(7) { animation-delay: 0.74s; }

@keyframes hfx-rise {
  from { opacity: 0; transform: translateY(22px); }
  to   { opacity: 1; transform: none; }
}

.hfx-logo { display: block; width: auto; max-height: 64px; max-width: 320px; object-fit: contain; margin-bottom: 28px; }

.hfx-tagline {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.34em;
  text-transform: uppercase;
  color: var(--text-dim);
  padding: 8px 16px;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: rgba(18, 18, 29, 0.55);
  margin-bottom: 30px;
}
.hfx-tagline i {
  width: 7px; height: 7px; border-radius: 50%;
  background: var(--grad-hot);
  box-shadow: 0 0 10px var(--magenta);
}

.hfx-hero .hfx-heading {
  font-size: clamp(46px, 4.6vw, 92px);
  font-weight: 800;
  line-height: 1.04;
  letter-spacing: -0.015em;
  margin-bottom: 26px;
}
.hfx-hero .hfx-heading span {
  display: block;
  -webkit-background-clip: text; background-clip: text;
  -webkit-text-fill-color: transparent; color: transparent;
}
.hfx-hero .hfx-heading .hfx-w-create   { background-image: linear-gradient(100deg, #e8fbff, var(--cyan) 55%, var(--blue)); filter: drop-shadow(0 0 26px rgba(0, 224, 255, 0.28)); }
.hfx-hero .hfx-heading .hfx-w-download { background-image: linear-gradient(100deg, #b9a6ff, var(--purple) 45%, var(--magenta)); filter: drop-shadow(0 0 26px rgba(127, 91, 255, 0.3)); }
.hfx-hero .hfx-heading .hfx-w-display  { background-image: linear-gradient(100deg, var(--magenta), #ff5a3c 55%, var(--orange)); filter: drop-shadow(0 0 26px rgba(255, 138, 0, 0.28)); }

.hfx-lede {
  font-size: clamp(15px, 1.25vw, 18px);
  font-weight: 400;
  line-height: 1.7;
  color: var(--text-dim);
  max-width: 54ch;
  margin-bottom: 38px;
}

/* ---------- CTAs ---------- */
.hfx-cta-row { display: flex; flex-wrap: wrap; gap: 16px; margin-bottom: 44px; }

.hfx-btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-size: 15px;
  font-weight: 700;
  letter-spacing: 0.03em;
  padding: 16px 30px;
  border-radius: 14px;
  transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease, background 0.22s ease;
}

.hfx-btn-primary {
  color: #fff;
  background: linear-gradient(100deg, var(--blue), var(--purple) 38%, var(--magenta) 72%, var(--orange));
  background-size: 150% 100%;
  box-shadow: 0 6px 30px rgba(127, 91, 255, 0.45), 0 0 60px rgba(255, 45, 255, 0.18);
}
.hfx-btn-primary:hover {
  transform: translateY(-2px);
  background-position: 100% 0;
  box-shadow: 0 10px 44px rgba(127, 91, 255, 0.6), 0 0 90px rgba(255, 45, 255, 0.3);
}

.hfx-btn-ghost {
  color: var(--text);
  border: 1px solid rgba(255, 255, 255, 0.16);
  background: rgba(18, 18, 29, 0.5);
  backdrop-filter: blur(8px);
}
.hfx-btn-ghost:hover {
  transform: translateY(-2px);
  border-color: rgba(0, 224, 255, 0.55);
  box-shadow: 0 0 34px rgba(0, 224, 255, 0.22);
}
.hfx-btn-ghost .hfx-spark { color: var(--cyan); }

/* ---------- feature icons ---------- */
.hfx-features {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px 22px;
  max-width: 520px;
}

.hfx-feature {
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 13px 15px;
  border: 1px solid rgba(255, 255, 255, 0.07);
  border-radius: 14px;
  background: var(--card);
  transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
}
.hfx-feature:hover { transform: translateY(-2px); }
.hfx-feature strong { font-size: 14px; font-weight: 600; letter-spacing: 0.02em; }

.hfx-f-ico {
  flex: none;
  width: 40px; height: 40px;
  border-radius: 11px;
  display: grid;
  place-items: center;
  border: 1px solid;
}
.hfx-f-ico svg { width: 20px; height: 20px; }
.hfx-f-ico img { width: 22px; height: 22px; object-fit: contain; }
.hfx-f-cyan    { color: var(--cyan);    border-color: rgba(0, 224, 255, 0.35);  background: rgba(0, 224, 255, 0.08);  box-shadow: 0 0 16px rgba(0, 224, 255, 0.14) inset; }
.hfx-f-purple  { color: #a58bff;        border-color: rgba(127, 91, 255, 0.42); background: rgba(127, 91, 255, 0.1);  box-shadow: 0 0 16px rgba(127, 91, 255, 0.16) inset; }
.hfx-f-magenta { color: var(--magenta); border-color: rgba(255, 45, 255, 0.35); background: rgba(255, 45, 255, 0.08); box-shadow: 0 0 16px rgba(255, 45, 255, 0.14) inset; }
.hfx-f-orange  { color: var(--orange);  border-color: rgba(255, 138, 0, 0.4);   background: rgba(255, 138, 0, 0.09);  box-shadow: 0 0 16px rgba(255, 138, 0, 0.15) inset; }

.hfx-feature:hover.hfx-h-cyan    { border-color: rgba(0, 224, 255, 0.5);  box-shadow: 0 8px 26px rgba(0, 224, 255, 0.12); }
.hfx-feature:hover.hfx-h-purple  { border-color: rgba(127, 91, 255, 0.55); box-shadow: 0 8px 26px rgba(127, 91, 255, 0.14); }
.hfx-feature:hover.hfx-h-magenta { border-color: rgba(255, 45, 255, 0.5);  box-shadow: 0 8px 26px rgba(255, 45, 255, 0.12); }
.hfx-feature:hover.hfx-h-orange  { border-color: rgba(255, 138, 0, 0.55);  box-shadow: 0 8px 26px rgba(255, 138, 0, 0.14); }

.hfx-footnote { margin-top: 22px; font-size: 12.5px; letter-spacing: 0.06em; color: rgba(154, 154, 180, 0.75); }

/* ==========================================================
   RIGHT — pipeline scene: laptop → phone → holo display
   ========================================================== */
.hfx-scene-wrap {
  display: flex;
  justify-content: flex-end;
  opacity: 0;
  animation: hfx-rise 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) 0.35s forwards;
}

.hfx-scene {
  position: relative;
  width: 640px;
  height: 700px;
  flex: none;
}

/* ----- flow arrows ----- */
.hfx-sc-arrows { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
.hfx-flow {
  fill: none;
  stroke-width: 2.4;
  stroke-linecap: round;
  stroke-dasharray: 7 9;
  animation: hfx-flow-dash 1.6s linear infinite;
}
.hfx-flow-a { stroke: #9a7dff; filter: drop-shadow(0 0 7px rgba(127, 91, 255, 0.8)); }
.hfx-flow-b { stroke: var(--orange); filter: drop-shadow(0 0 7px rgba(255, 138, 0, 0.8)); }
@keyframes hfx-flow-dash { to { stroke-dashoffset: -32; } }

.hfx-flow-label {
  position: absolute;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  pointer-events: none;
}
.hfx-fl-a { left: 36%; top: 39.5%; color: #a58bff; text-shadow: 0 0 12px rgba(127, 91, 255, 0.7); }
.hfx-fl-b { left: 50%; top: 71%; color: var(--orange); text-shadow: 0 0 12px rgba(255, 138, 0, 0.7); }

/* ----- laptop ----- */
.hfx-sc-laptop {
  position: absolute;
  top: 12px; left: 0;
  width: 47%;
  animation: hfx-bob 7s ease-in-out infinite;
}

.hfx-laptop-screen {
  border: 1px solid #2b2b42;
  border-radius: 13px 13px 3px 3px;
  background: #07070e;
  padding: 7px 7px 9px;
  box-shadow:
    0 24px 60px rgba(0, 0, 0, 0.7),
    0 0 46px rgba(46, 124, 255, 0.16),
    inset 0 0 0 1px rgba(255, 255, 255, 0.03);
}
.hfx-laptop-base {
  height: 11px;
  margin: 0 -5.5%;
  border-radius: 2px 2px 12px 12px;
  background: linear-gradient(#262639, #101019 70%);
  border: 1px solid #2b2b42;
  border-top: 0;
  position: relative;
}
.hfx-laptop-base::after {
  content: "";
  position: absolute;
  left: 50%; top: 0;
  transform: translateX(-50%);
  width: 18%; height: 4px;
  border-radius: 0 0 6px 6px;
  background: #060609;
}

.hfx-ui { border-radius: 7px; overflow: hidden; background: #0b0b14; border: 1px solid rgba(127, 91, 255, 0.14); }

.hfx-ui-top {
  display: flex; align-items: center; gap: 5px;
  padding: 6px 8px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  background: rgba(255, 255, 255, 0.02);
}
.hfx-ui-dot { width: 6px; height: 6px; border-radius: 50%; }
.hfx-ui-top .hfx-t { margin-left: 6px; font-size: 8px; font-weight: 700; letter-spacing: 0.22em; color: #c9c9de; }
.hfx-ui-top .hfx-chip {
  margin-left: auto;
  font-size: 7px; font-weight: 700; letter-spacing: 0.08em;
  padding: 2.5px 7px; border-radius: 999px; color: #fff;
  background: linear-gradient(90deg, var(--purple), var(--magenta));
}

.hfx-ui-body { display: grid; grid-template-columns: 26px 1fr 52px; height: 128px; }

.hfx-ui-tools { border-right: 1px solid rgba(255, 255, 255, 0.05); padding: 7px 0; display: flex; flex-direction: column; align-items: center; gap: 7px; }
.hfx-ui-tool { width: 12px; height: 12px; border-radius: 4px; background: rgba(255, 255, 255, 0.09); }
.hfx-ui-tool.hfx-on { background: linear-gradient(135deg, var(--cyan), var(--purple)); box-shadow: 0 0 8px rgba(0, 224, 255, 0.6); }

.hfx-ui-canvas {
  position: relative;
  display: grid;
  place-items: center;
  background:
    radial-gradient(60% 65% at 50% 52%, rgba(127, 91, 255, 0.2), transparent 70%),
    #08080f;
}
.hfx-ui-canvas svg { width: 92px; height: 88px; }
.hfx-ui-canvas .hfx-canvas-img { max-width: 88%; max-height: 88%; width: auto; height: auto; object-fit: contain; }
.hfx-ui-canvas .hfx-sel {
  position: absolute;
  width: 104px; height: 96px;
  border: 1px dashed rgba(0, 224, 255, 0.45);
  border-radius: 4px;
}
.hfx-ui-canvas .hfx-sel i {
  position: absolute; width: 5px; height: 5px;
  background: var(--cyan); border-radius: 1px;
}
.hfx-ui-canvas .hfx-sel i:nth-child(1) { top: -3px; left: -3px; }
.hfx-ui-canvas .hfx-sel i:nth-child(2) { top: -3px; right: -3px; }
.hfx-ui-canvas .hfx-sel i:nth-child(3) { bottom: -3px; left: -3px; }
.hfx-ui-canvas .hfx-sel i:nth-child(4) { bottom: -3px; right: -3px; }

.hfx-ui-panel { border-left: 1px solid rgba(255, 255, 255, 0.05); padding: 8px 7px; display: flex; flex-direction: column; gap: 7px; }
.hfx-ui-line { height: 4px; border-radius: 2px; background: rgba(255, 255, 255, 0.1); }
.hfx-ui-line.hfx-short { width: 62%; }
.hfx-ui-slider { height: 3px; border-radius: 2px; background: rgba(255, 255, 255, 0.08); position: relative; margin-top: 3px; }
.hfx-ui-slider span { position: absolute; inset: 0 auto 0 0; border-radius: 2px; }
.hfx-ui-slider.hfx-s1 span { width: 70%; background: linear-gradient(90deg, var(--cyan), var(--blue)); }
.hfx-ui-slider.hfx-s2 span { width: 45%; background: linear-gradient(90deg, var(--purple), var(--magenta)); }
.hfx-ui-slider.hfx-s3 span { width: 58%; background: linear-gradient(90deg, var(--magenta), var(--orange)); }
.hfx-ui-swatches { display: flex; gap: 4px; margin-top: auto; }
.hfx-ui-swatches i { width: 9px; height: 9px; border-radius: 3px; }

.hfx-ui-timeline {
  display: flex; align-items: center; gap: 6px;
  padding: 6px 8px;
  border-top: 1px solid rgba(255, 255, 255, 0.06);
}
.hfx-ui-play {
  width: 13px; height: 13px; border-radius: 50%;
  background: linear-gradient(135deg, var(--cyan), var(--purple));
  display: grid; place-items: center;
  font-size: 6px; color: #fff;
}
.hfx-ui-track { flex: 1; height: 4px; border-radius: 2px; background: rgba(255, 255, 255, 0.08); position: relative; }
.hfx-ui-track span {
  position: absolute; inset: 0 auto 0 0; width: 55%;
  border-radius: 2px;
  background: var(--grad-hot);
  animation: hfx-track 5s ease-in-out infinite alternate;
}
@keyframes hfx-track { from { width: 22%; } to { width: 82%; } }
.hfx-ui-time { font-size: 6.5px; color: var(--text-dim); letter-spacing: 0.06em; }

.hfx-sc-caption {
  margin-top: 12px;
  text-align: center;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  white-space: nowrap;
  color: var(--text-dim);
}

/* ----- phone ----- */
.hfx-sc-phone {
  position: absolute;
  top: 43.5%; left: 18%;
  width: 21.5%;
  animation: hfx-bob 7s ease-in-out 1.2s infinite;
}

.hfx-phone-frame {
  border: 1px solid #2e2e46;
  border-radius: 22px;
  background: #07070e;
  padding: 6px;
  box-shadow:
    0 22px 54px rgba(0, 0, 0, 0.7),
    0 0 42px rgba(255, 45, 255, 0.14),
    inset 0 0 0 1px rgba(255, 255, 255, 0.03);
}
.hfx-phone-screen {
  position: relative;
  border-radius: 17px;
  overflow: hidden;
  background: #0b0b14;
  border: 1px solid rgba(127, 91, 255, 0.14);
  padding: 20px 9px 10px;
}
.hfx-phone-notch {
  position: absolute; top: 5px; left: 50%;
  transform: translateX(-50%);
  width: 36%; height: 7px;
  border-radius: 999px;
  background: #05050a;
  border: 1px solid rgba(255, 255, 255, 0.06);
  display: block;
}
.hfx-phone-head { font-size: 6.5px; font-weight: 700; letter-spacing: 0.3em; color: var(--text-dim); text-align: center; margin-bottom: 7px; }

.hfx-phone-thumb {
  position: relative;
  border-radius: 10px;
  background:
    radial-gradient(70% 70% at 50% 52%, rgba(255, 45, 255, 0.16), transparent 72%),
    #08080f;
  border: 1px solid rgba(255, 45, 255, 0.22);
  display: grid;
  place-items: center;
  padding: 8px 0 6px;
}
.hfx-phone-thumb svg { width: 62px; height: 58px; }
.hfx-phone-thumb .hfx-thumb-img { max-width: 88%; max-height: 62px; width: auto; height: auto; object-fit: contain; }

.hfx-phone-file { display: flex; align-items: baseline; justify-content: space-between; margin: 7px 1px 5px; }
.hfx-phone-file b { font-size: 6.8px; font-weight: 600; letter-spacing: 0.04em; color: #d6d6e8; }
.hfx-phone-file span { font-size: 6px; color: var(--text-dim); }

.hfx-phone-pill {
  display: flex; align-items: center; justify-content: center; gap: 4px;
  font-size: 6.5px; font-weight: 700; letter-spacing: 0.12em;
  color: var(--teal);
  border: 1px solid rgba(0, 255, 209, 0.35);
  background: rgba(0, 255, 209, 0.07);
  border-radius: 999px;
  padding: 3.5px 0;
  margin-bottom: 6px;
  text-shadow: 0 0 8px rgba(0, 255, 209, 0.7);
}

.hfx-phone-cast {
  display: block;
  width: 100%;
  text-align: center;
  font-size: 7px; font-weight: 700; letter-spacing: 0.1em;
  color: #fff;
  padding: 5px 0;
  border-radius: 8px;
  background: linear-gradient(90deg, var(--purple), var(--magenta) 60%, var(--orange));
  box-shadow: 0 0 14px rgba(255, 45, 255, 0.35);
}

/* ----- holo display ----- */
.hfx-sc-display {
  position: absolute;
  right: 0;
  top: 22%;
  width: 52%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hfx-fan-zone { position: relative; width: 100%; aspect-ratio: 1; }

.hfx-fan-ring {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 1.5px solid rgba(0, 224, 255, 0.22);
  background:
    radial-gradient(58% 58% at 50% 50%, rgba(127, 91, 255, 0.13), transparent 72%),
    radial-gradient(46% 46% at 50% 58%, rgba(255, 138, 0, 0.09), transparent 70%);
  box-shadow:
    0 0 60px rgba(127, 91, 255, 0.22),
    0 0 120px rgba(0, 224, 255, 0.1),
    inset 0 0 46px rgba(0, 224, 255, 0.07);
  overflow: hidden;
}

.hfx-fan-blade {
  position: absolute;
  inset: 4%;
  border-radius: 50%;
  background: conic-gradient(from 0deg,
    transparent 0deg 28deg,
    rgba(0, 224, 255, 0.16) 46deg,
    rgba(127, 91, 255, 0.1) 58deg,
    transparent 78deg 180deg,
    rgba(255, 45, 255, 0.1) 216deg,
    rgba(255, 138, 0, 0.12) 232deg,
    transparent 254deg 360deg);
  filter: blur(3px);
  animation: hfx-spin 1.1s linear infinite;
  display: block;
}
.hfx-fan-scan {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: repeating-linear-gradient(0deg,
    rgba(0, 224, 255, 0.045) 0 1px,
    transparent 1px 5px);
  mix-blend-mode: screen;
  display: block;
}
@keyframes hfx-spin { to { transform: rotate(360deg); } }

.hfx-fan-hub {
  position: absolute;
  left: 50%; top: 50%;
  transform: translate(-50%, -50%);
  width: 9%; height: 9%;
  border-radius: 50%;
  background: radial-gradient(circle at 38% 34%, #33334e, #0a0a12 70%);
  border: 1px solid rgba(0, 224, 255, 0.4);
  box-shadow: 0 0 18px rgba(0, 224, 255, 0.55);
  display: block;
}

.hfx-holo-art {
  position: absolute;
  left: 50%; top: 47%;
  transform: translate(-50%, -50%);
  width: 92%;
  animation: hfx-hover-holo 5.5s ease-in-out infinite;
  filter:
    drop-shadow(0 0 26px rgba(255, 138, 0, 0.35))
    drop-shadow(0 0 60px rgba(127, 91, 255, 0.3));
}
.hfx-holo-art .hfx-holo-img { display: block; width: 100%; height: auto; max-height: 100%; object-fit: contain; }
@keyframes hfx-hover-holo {
  0%, 100% { transform: translate(-50%, -50%); }
  50%      { transform: translate(-50%, -54%); }
}

.hfx-display-stand {
  width: 7px; height: 52px;
  margin-top: -4px;
  background: linear-gradient(180deg, #202033, #0c0c14);
  border-radius: 3px;
}
.hfx-display-base {
  width: 34%; height: 11px;
  border-radius: 999px;
  background: linear-gradient(180deg, #23233a, #0d0d16);
  border: 1px solid #2b2b42;
  box-shadow: 0 16px 34px rgba(0, 0, 0, 0.8);
}
.hfx-display-shadow {
  width: 76%; height: 22px;
  margin-top: 8px;
  border-radius: 50%;
  background: radial-gradient(50% 50% at 50% 50%, rgba(127, 91, 255, 0.24), transparent 72%);
  filter: blur(6px);
}

.hfx-display-caption {
  margin-top: 2px;
  display: inline-flex;
  align-items: center;
  gap: 7px;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.26em;
  text-transform: uppercase;
  white-space: nowrap;
  color: var(--text-dim);
}
.hfx-display-caption .hfx-live {
  display: inline-flex; align-items: center; gap: 5px;
  color: var(--teal);
  text-shadow: 0 0 10px rgba(0, 255, 209, 0.8);
}
.hfx-display-caption .hfx-live::before {
  content: "";
  width: 6px; height: 6px; border-radius: 50%;
  background: var(--teal);
  box-shadow: 0 0 8px var(--teal);
  animation: hfx-pulse 1.8s ease-in-out infinite;
}
@keyframes hfx-pulse { 50% { opacity: 0.35; } }

@keyframes hfx-bob {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-10px); }
}

/* ---------- responsive ---------- */
@media (min-width: 1700px) {
  .hfx-scene { transform: scale(1.18); transform-origin: center right; }
  .hfx-copy { max-width: 680px; }
}

@media (max-width: 1240px) {
  .hfx-scene { transform: scale(0.84); transform-origin: top right; height: 600px; }
}

@media (max-width: 1080px) {
  .hfx-hero { min-height: 0; }
  .hfx-hero-inner { grid-template-columns: minmax(0, 1fr); padding-top: 64px; }
  .hfx-copy { max-width: 640px; }
  .hfx-scene-wrap { justify-content: center; }
  .hfx-scene { transform: none; height: 700px; }
}

@media (max-width: 700px) {
  .hfx-scene { transform: scale(0.72); transform-origin: top center; height: 520px; }
  .hfx-cta-row .hfx-btn { flex: 1 1 100%; justify-content: center; }
}

@media (max-width: 480px) {
  .hfx-features { grid-template-columns: 1fr; }
  .hfx-scene { transform: scale(0.55); height: 400px; }
}

@media (prefers-reduced-motion: reduce) {
  .hfx-hero *, .hfx-hero *::before, .hfx-hero *::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; }
  .hfx-copy > *, .hfx-scene-wrap { opacity: 1; }
}
</style>


    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Primary button label",
      "default": "Launch HoloStudio"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Secondary button label",
      "default": "Explore AI Holo Lab"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Secondary button link"
    },
    {
      "type": "header",
      "content": "Scene images (PNG slots)"
    },
    {
      "type": "image_picker",
      "id": "laptop_image",
      "label": "Laptop screen image",
      "info": "Shown on the HoloStudio canvas. Transparent PNG recommended."
    },
    {
      "type": "image_picker",
      "id": "phone_image",
      "label": "Phone screen image",
      "info": "Shown as the downloaded hologram thumbnail. Transparent PNG recommended."
    },
    {
      "type": "image_picker",
      "id": "hologram_image",
      "label": "Hologram image (circular display)",
      "info": "Projected inside the Holofex display circle. Transparent PNG strongly recommended — it gets a neon glow."
    },
    {
      "type": "header",
      "content": "Scene text"
    },
    {
      "type": "text",
      "id": "laptop_app_name",
      "label": "Laptop app name",
      "default": "HOLOSTUDIO"
    },
    {
      "type": "text",
      "id": "phone_app_name",
      "label": "Phone app name",
      "default": "HOLOFEX"
    },
    {
      "type": "text",
      "id": "phone_file_name",
      "label": "Phone file name",
      "default": "phoenix_loop.holo"
    },
    {
      "type": "text",
      "id": "phone_file_size",
      "label": "Phone file size",
      "default": "24 MB"
    },
    {
      "type": "text",
      "id": "caption_1",
      "label": "Laptop caption",
      "default": "1 · Create in HoloStudio"
    },
    {
      "type": "text",
      "id": "caption_2",
      "label": "Phone caption",
      "default": "2 · On your phone"
    },
    {
      "type": "text",
      "id": "caption_3",
      "label": "Display caption",
      "default": "3 · Holofex X1"
    },
    {
      "type": "checkbox",
      "id": "show_live_badge",
      "label": "Show LIVE badge",
      "default": true
    },
    {
      "type": "text",
      "id": "arrow_label_1",
      "label": "First arrow label",
      "default": "Download"
    },
    {
      "type": "text",
      "id": "arrow_label_2",
      "label": "Second arrow label",
      "default": "Cast"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Feature name"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "sparkle", "label": "AI sparkle" },

{% comment %}
  ============================================================
  HOLOFEX — "AI Holo Lab Pricing" section (Shopify)
  Black background · purple / blue / orange neon accents

  Install: Online Store → Themes → Edit code → sections/
           → Add a new section → "holofex-pricing"
           → paste this whole file, save, then add the section
           in the theme customizer.

  Each plan is a block with:
    · Plan name (accent-coloured) + animations line
    · Price + period
    · Feature checklist (one feature per line)
    · Solid gradient CTA button
    · Accent colour (cyan / blue / purple / magenta / orange)
    · Optional "Popular" highlight badge + stronger glow
  The section background is a colour picker; heading text flips
  automatically between light and dark to stay readable.
  ============================================================
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Exo+2:wght@400;600;700;800&display=swap" rel="stylesheet">

<style>
/* ==========================================================
   HOLOFEX PRICING — all rules scoped under .hfx-pr
   ========================================================== */
.hfx-pr, .hfx-pr * { margin: 0; padding: 0; box-sizing: border-box; }

.hfx-pr a { color: inherit; text-decoration: none; }

.hfx-pr {
  --cyan: #00e0ff;
  --blue: #2e7cff;
  --purple: #7f5bff;
  --magenta: #ff2dff;
  --orange: #ff8a00;
  --text: #f4f4fa;
  --text-dim: #9a9ab4;

  position: relative;
  background: var(--hfx-pr-bgc, #000);
  color: var(--text);
  font-family: "Exo 2", system-ui, sans-serif;
  -webkit-font-smoothing: antialiased;
  padding: clamp(56px, 8vh, 100px) clamp(20px, 4vw, 48px);
  overflow: hidden;
  isolation: isolate;
}

.hfx-pr-bg {
  position: absolute;
  inset: 0;
  z-index: -1;
  background:
    radial-gradient(44% 52% at 8% 10%,   rgba(127, 91, 255, 0.13), transparent 65%),
    radial-gradient(40% 48% at 50% 0%,   rgba(46, 124, 255, 0.10), transparent 65%),
    radial-gradient(42% 50% at 94% 90%,  rgba(255, 138, 0, 0.09),  transparent 65%);
}

.hfx-pr-inner { max-width: var(--hfx-pr-max-w, 1240px); margin: 0 auto; }

/* ---------- header ---------- */
.hfx-pr-head { text-align: center; max-width: 720px; margin: 0 auto clamp(34px, 5vh, 52px); }

.hfx-pr-title {
  font-size: clamp(26px, 3.2vw, 42px);
  font-weight: 800;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  margin-bottom: 12px;
}
.hfx-pr-sub { font-size: clamp(14px, 1.1vw, 16px); color: var(--text-dim); line-height: 1.6; }

/* ---------- plan grid ---------- */
.hfx-pr-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: clamp(18px, 2vw, 28px);
  align-items: stretch;
}

/* accent palettes (set per plan) */
.hfx-pr-a-cyan    { --acc: #00e0ff; --acc2: #2e7cff; --acc-ink: #baf3ff; }
.hfx-pr-a-blue    { --acc: #2e7cff; --acc2: #00a2ff; --acc-ink: #b9d4ff; }
.hfx-pr-a-purple  { --acc: #7f5bff; --acc2: #b44bff; --acc-ink: #d3c5ff; }
.hfx-pr-a-magenta { --acc: #ff2dff; --acc2: #7f5bff; --acc-ink: #ffc4ff; }
.hfx-pr-a-orange  { --acc: #ff8a00; --acc2: #ff4d1c; --acc-ink: #ffd9ae; }

.hfx-pr-card {
  position: relative;
  display: flex;
  flex-direction: column;
  border-radius: 16px;
  border: 1px solid color-mix(in srgb, var(--acc) 28%, transparent);
  background:
    radial-gradient(120% 60% at 50% 0%, color-mix(in srgb, var(--acc) 11%, transparent), transparent 60%),
    linear-gradient(180deg, #0c0c16, #07070d);
  padding: 26px 24px 24px;
  transition: transform 0.28s ease, box-shadow 0.28s ease, border-color 0.28s ease;
}
.hfx-pr-card:hover {
  transform: translateY(-5px);
  border-color: color-mix(in srgb, var(--acc) 55%, transparent);
  box-shadow: 0 18px 50px rgba(0, 0, 0, 0.6), 0 0 44px color-mix(in srgb, var(--acc) 20%, transparent);
}

/* highlighted (Popular) plan */
.hfx-pr-card.hfx-pr-hot {
  border-color: color-mix(in srgb, var(--acc) 65%, transparent);
  box-shadow: 0 0 40px color-mix(in srgb, var(--acc) 22%, transparent), 0 18px 50px rgba(0, 0, 0, 0.55);
}

.hfx-pr-flag {
  position: absolute;
  top: -12px;
  right: 18px;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #fff;
  padding: 5px 13px;
  border-radius: 8px;
  background: linear-gradient(95deg, var(--acc), var(--acc2));
  box-shadow: 0 0 18px color-mix(in srgb, var(--acc) 55%, transparent);
}

/* ---------- plan copy ---------- */
.hfx-pr-name {
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--acc);
  text-shadow: 0 0 14px color-mix(in srgb, var(--acc) 50%, transparent);
  margin-bottom: 8px;
}

.hfx-pr-anim {
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: #dcdcec;
  margin-bottom: 18px;
}

.hfx-pr-price-row { display: flex; align-items: baseline; gap: 8px; margin-bottom: 22px; }
.hfx-pr-price {
  font-size: clamp(30px, 2.6vw, 40px);
  font-weight: 800;
  letter-spacing: -0.01em;
}
.hfx-pr-period { font-size: 13px; color: var(--text-dim); }

/* ---------- feature list ---------- */
.hfx-pr-feats { list-style: none; display: flex; flex-direction: column; gap: 11px; margin-bottom: 26px; }

.hfx-pr-feat {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  font-size: 13px;
  line-height: 1.5;
  color: #cfcfe2;
}
.hfx-pr-feat svg {
  flex: none;
  width: 13px; height: 13px;
  margin-top: 3px;
  color: var(--acc);
  filter: drop-shadow(0 0 5px color-mix(in srgb, var(--acc) 60%, transparent));
}

/* ---------- CTA ---------- */
.hfx-pr-btn {
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  padding: 14px 20px;
  border-radius: 10px;
  font-size: 12.5px;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #fff;
  background: linear-gradient(95deg, var(--acc), var(--acc2));
  box-shadow: 0 4px 22px color-mix(in srgb, var(--acc) 35%, transparent);
  transition: transform 0.22s ease, box-shadow 0.22s ease, filter 0.22s ease;
}
.hfx-pr-btn:hover {
  transform: translateY(-2px);
  filter: brightness(1.08);
  box-shadow: 0 8px 32px color-mix(in srgb, var(--acc) 55%, transparent);
}

/* ---------- footnote ---------- */
.hfx-pr-note {
  text-align: center;
  margin-top: clamp(24px, 4vh, 36px);
  font-size: 12.5px;
  letter-spacing: 0.04em;
  color: var(--text-dim);
}

/* ---------- light-background mode (auto when the picked colour is light) ---------- */
.hfx-pr-light .hfx-pr-bg { opacity: 0.45; }
.hfx-pr-light .hfx-pr-title { color: #0d0d16; }
.hfx-pr-light .hfx-pr-sub { color: #5c5c72; }
.hfx-pr-light .hfx-pr-note { color: #6a6a82; }
.hfx-pr-light .hfx-pr-card { box-shadow: 0 14px 44px rgba(12, 12, 26, 0.16); }
.hfx-pr-light .hfx-pr-card:hover { box-shadow: 0 22px 60px rgba(12, 12, 26, 0.22), 0 0 44px color-mix(in srgb, var(--acc) 26%, transparent); }

/* ---------- responsive ---------- */
@media (max-width: 1080px) {
  .hfx-pr-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (max-width: 720px) {
  .hfx-pr-grid { grid-template-columns: minmax(0, 1fr); max-width: 440px; margin: 0 auto; }
}

@media (prefers-reduced-motion: reduce) {
  .hfx-pr *, .hfx-pr *::before, .hfx-pr *::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; }
}
</style>

{%- liquid
  assign pr_bgc = section.settings.background_color | default: '#000000'
  assign pr_bgc_str = pr_bgc | append: ''
  if pr_bgc_str == blank or pr_bgc_str == 'rgba(0,0,0,0)'
    assign pr_bgc = '#000000'
  endif
  assign pr_bright = pr_bgc | color_brightness | default: 0
  if pr_bright > 140
    assign pr_mode = 'hfx-pr-light'
  else
    assign pr_mode = ''
  endif
-%}
<section class="hfx-pr {{ pr_mode }}" style="--hfx-pr-max-w: {{ section.settings.max_width | default: 1240 }}px; --hfx-pr-bgc: {{ pr_bgc }};">
  <div class="hfx-pr-bg" aria-hidden="true"></div>

  <div class="hfx-pr-inner">

    <div class="hfx-pr-head">
      {%- if section.settings.heading != blank -%}
        <h2 class="hfx-pr-title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="hfx-pr-sub">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="hfx-pr-grid">
      {%- for block in section.blocks -%}
        <article
          class="hfx-pr-card hfx-pr-a-{{ block.settings.accent }}{% if block.settings.highlight %} hfx-pr-hot{% endif %}"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.highlight and block.settings.highlight_label != blank -%}
            <span class="hfx-pr-flag">{{ block.settings.highlight_label }}</span>
          {%- endif -%}

          {%- if block.settings.plan_name != blank -%}
            <h3 class="hfx-pr-name">{{ block.settings.plan_name }}</h3>
          {%- endif -%}

          {%- if block.settings.plan_detail != blank -%}
            <p class="hfx-pr-anim">{{ block.settings.plan_detail }}</p>
          {%- endif -%}

          <div class="hfx-pr-price-row">
            <span class="hfx-pr-price">{{ block.settings.price }}</span>
            {%- if block.settings.period != blank -%}
              <span class="hfx-pr-period">{{ block.settings.period }}</span>
            {%- endif -%}
          </div>

          {%- if block.settings.features != blank -%}
            {%- assign feat_lines = block.settings.features | newline_to_br | split: '<br />' -%}
            <ul class="hfx-pr-feats">
              {%- for line in feat_lines -%}
                {%- assign feat = line | strip_newlines | strip -%}
                {%- if feat != blank -%}
                  <li class="hfx-pr-feat">
                    <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 7.5 5.5 11 12 3.5"/></svg>
                    {{ feat }}
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {%- if block.settings.button_label != blank -%}
            <a class="hfx-pr-btn" href="{{ block.settings.button_link | default: '#' }}">{{ block.settings.button_label }}</a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>

    {%- if section.settings.footnote != blank -%}
      <p class="hfx-pr-note">{{ section.settings.footnote }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Holofex Pricing",
  "tag": "section",
  "class": "hfx-pr-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "AI Holo Lab Pricing"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Simple, transparent pricing for AI generated animations."
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Footnote (optional)"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background colour",
      "default": "#000000",
      "info": "Heading text flips automatically between dark and light to stay readable."
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum content width (px)",
      "min": 1000,
      "max": 1800,
      "step": 40,
      "default": 1240
    }
  ],
  "blocks": [
    {
      "type": "plan",
      "name": "Plan",
      "settings": [
        {
          "type": "select",
          "id": "accent",
          "label": "Accent colour",
          "options": [
            { "value": "cyan", "label": "Cyan" },
            { "value": "blue", "label": "Blue" },
            { "value": "purple", "label": "Purple" },
            { "value": "magenta", "label": "Magenta" },
            { "value": "orange", "label": "Orange" }
          ],
          "default": "purple"
        },
        {
          "type": "text",
          "id": "plan_name",
          "label": "Plan name",
          "default": "Starter"
        },
        {
          "type": "text",
          "id": "plan_detail",
          "label": "Detail line",
          "default": "5 animations"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$24.95"
        },
        {
          "type": "text",
          "id": "period",
          "label": "Period",
          "default": "/month"
        },
        {
          "type": "textarea",
          "id": "features",
          "label": "Features (one per line)",
          "default": "5 AI generated animations\nHigh quality export\nCommercial use\nCancel anytime"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Get started"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "checkbox",
          "id": "highlight",
          "label": "Highlight this plan",
          "default": false
        },
        {
          "type": "text",
          "id": "highlight_label",
          "label": "Highlight badge text",
          "default": "Popular"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Holofex Pricing",
      "blocks": [
        {
          "type": "plan",
          "settings": {
            "accent": "purple",
            "plan_name": "Starter",
            "plan_detail": "5 animations",
            "price": "$24.95",
            "period": "/month",
            "features": "5 AI generated animations\nHigh quality export\nCommercial use\nCancel anytime",
            "button_label": "Get started"
          }
        },
        {
          "type": "plan",
          "settings": {
            "accent": "blue",
            "plan_name": "Pro",
            "plan_detail": "10 animations",
            "price": "$34.95",
            "period": "/month",
            "features": "10 AI generated animations\nHigh quality export\nCommercial use\nPriority generation\nCancel anytime",
            "button_label": "Get started",
            "highlight": true,
            "highlight_label": "Popular"
          }
        },
        {
          "type": "plan",
          "settings": {
            "accent": "orange",
            "plan_name": "Studio",
            "plan_detail": "20 animations",
            "price": "$44.95",
            "period": "/month",
            "features": "20 AI generated animations\nHigh quality export\nCommercial use\nPriority generation\nCancel anytime",
            "button_label": "Get started"
          }
        }
      ]
    }
  ]
}
{% endschema %}
